<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Optional, and only asked for at the first Read aloud on Android 13+. Denied, the service
         still plays and the in-flow controls still work; only the system notification is missing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TextToSpeech finds the engine through PackageManager, which Android 11+ filters to the apps declared
         here. Without this, a chosen engine such as eSpeak or RHVoice is invisible and read aloud falls back
         or fails. Scoped to the TTS service action, so QUERY_ALL_PACKAGES is not needed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Papyrus">

        <activity
            android:name=".MainActivity"
            android:autoRemoveFromRecents="true"
            android:documentLaunchMode="intoExisting"
            android:exported="true"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <!-- configChanges keeps scroll/zoom/find alive across a resize (the Compose-only default);
                 uiMode/locale/layoutDirection/fontScale are left out so MarkdownViewer's AndroidView recreates, and adjustNothing stops the IME re-measuring the viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
                <!-- Every text format the viewer opens: markdown, plain text and the CODE extensions
                     (xml, html, yaml, json, source files). Providers label these text/*, so one entry
                     covers them all instead of naming each. -->
                <data android:mimeType="text/*" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.text-template" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template" />
                <data android:mimeType="application/vnd.ms-word.document.macroenabled.12" />
                <data android:mimeType="application/vnd.ms-word.template.macroenabled.12" />
                <!-- The non-text/* spellings providers use for openable code files. -->
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>
        </activity>

        <!-- Shares filesDir/imports as a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".tts.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
