+++ b/app/src/main/java/com/papyrus/app/viewer/EpubEntities.kt
@@ -0,0 +1,86 @@
+package com.papyrus.app.viewer
+
+import org.xmlpull.v1.XmlPullParser
+import org.xmlpull.v1.XmlPullParserException
+
+/**
+ * The named character references of HTML 4, which XML does not define. Real-world XHTML is full of
+ * `&nbsp;` and `&mdash;`, and a strict parser treats each as an error that would drop the whole chapter.
+ * They are handed to the parser through the standard `defineEntityReplacementText`, which Android's
+ * parser and kxml2 share (Android's is a descendant of it), so a chapter reads the same in the app and in
+ * a JVM test. The five XML ones (`amp`, `lt`, `gt`, `quot`, `apos`) are the parser's own.
+ */
+internal object EpubEntities {
+
+    /** U+00A0 to U+00FF in order: the entity of code point `0xA0 + i` is `LATIN1[i]`. */
+    private val LATIN1 = (
+        "nbsp iexcl cent pound curren yen brvbar sect uml copy ordf laquo not shy reg macr " +
+            "deg plusmn sup2 sup3 acute micro para middot cedil sup1 ordm raquo frac14 frac12 frac34 iquest " +
+            "Agrave Aacute Acirc Atilde Auml Aring AElig Ccedil Egrave Eacute Ecirc Euml Igrave Iacute Icirc Iuml " +
+            "ETH Ntilde Ograve Oacute Ocirc Otilde Ouml times Oslash Ugrave Uacute Ucirc Uuml Yacute THORN szlig " +
+            "agrave aacute acirc atilde auml aring aelig ccedil egrave eacute ecirc euml igrave iacute icirc iuml " +
+            "eth ntilde ograve oacute ocirc otilde ouml divide oslash ugrave uacute ucirc uuml yacute thorn yuml"
+        ).split(' ')
+
+    private const val LATIN1_START = 0xA0
+
+    /** Greek capitals from Alpha (U+0391); U+03A2 has no letter, so Sigma follows Rho at U+03A3. */
+    private val GREEK_CAPITAL = listOf(
+        "Alpha", "Beta", "Gamma", "Delta", "Epsilon", "Zeta", "Eta", "Theta", "Iota", "Kappa", "Lambda", "Mu",
+        "Nu", "Xi", "Omicron", "Pi", "Rho", null, "Sigma", "Tau", "Upsilon", "Phi", "Chi", "Psi", "Omega",
+    )
+
+    /** Greek small letters from alpha (U+03B1); U+03C2 is the final sigma. */
+    private val GREEK_SMALL = listOf(
+        "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu",
+        "nu", "xi", "omicron", "pi", "rho", "sigmaf", "sigma", "tau", "upsilon", "phi", "chi", "psi", "omega",
+    )
+
+    private const val GREEK_CAPITAL_START = 0x391
+    private const val GREEK_SMALL_START = 0x3B1
+
+    private val OTHERS: Map<String, Int> = mapOf(
+        "OElig" to 338, "oelig" to 339, "Scaron" to 352, "scaron" to 353, "Yuml" to 376, "fnof" to 402,
+        "circ" to 710, "tilde" to 732, "thetasym" to 977, "upsih" to 978, "piv" to 982,
+        "ensp" to 8194, "emsp" to 8195, "thinsp" to 8201, "zwnj" to 8204, "zwj" to 8205, "lrm" to 8206, "rlm" to 8207,
+        "ndash" to 8211, "mdash" to 8212, "lsquo" to 8216, "rsquo" to 8217, "sbquo" to 8218,
+        "ldquo" to 8220, "rdquo" to 8221, "bdquo" to 8222, "dagger" to 8224, "Dagger" to 8225,
+        "bull" to 8226, "hellip" to 8230, "permil" to 8240, "prime" to 8242, "Prime" to 8243,
+        "lsaquo" to 8249, "rsaquo" to 8250, "oline" to 8254, "frasl" to 8260, "euro" to 8364,
+        "image" to 8465, "weierp" to 8472, "real" to 8476, "trade" to 8482, "alefsym" to 8501,
+        "larr" to 8592, "uarr" to 8593, "rarr" to 8594, "darr" to 8595, "harr" to 8596, "crarr" to 8629,
+        "lArr" to 8656, "uArr" to 8657, "rArr" to 8658, "dArr" to 8659, "hArr" to 8660,
+        "forall" to 8704, "part" to 8706, "exist" to 8707, "empty" to 8709, "nabla" to 8711, "isin" to 8712,
+        "notin" to 8713, "ni" to 8715, "prod" to 8719, "sum" to 8721, "minus" to 8722, "lowast" to 8727,
+        "radic" to 8730, "prop" to 8733, "infin" to 8734, "ang" to 8736, "and" to 8743, "or" to 8744,
+        "cap" to 8745, "cup" to 8746, "int" to 8747, "there4" to 8756, "sim" to 8764, "cong" to 8773,
+        "asymp" to 8776, "ne" to 8800, "equiv" to 8801, "le" to 8804, "ge" to 8805, "sub" to 8834,
+        "sup" to 8835, "nsub" to 8836, "sube" to 8838, "supe" to 8839, "oplus" to 8853, "otimes" to 8855,
+        "perp" to 8869, "sdot" to 8901, "lceil" to 8968, "rceil" to 8969, "lfloor" to 8970, "rfloor" to 8971,
+        "lang" to 9001, "rang" to 9002, "loz" to 9674, "spades" to 9824, "clubs" to 9827, "hearts" to 9829,
+        "diams" to 9830,
+    )
+
+    /** Every entity this object defines, name to its text. */
+    val ALL: Map<String, String> = buildMap {
+        LATIN1.forEachIndexed { i, name -> put(name, String(Character.toChars(LATIN1_START + i))) }
+        GREEK_CAPITAL.forEachIndexed { i, name -> if (name != null) put(name, String(Character.toChars(GREEK_CAPITAL_START + i))) }
+        GREEK_SMALL.forEachIndexed { i, name -> put(name, String(Character.toChars(GREEK_SMALL_START + i))) }
+        OTHERS.forEach { (name, code) -> put(name, String(Character.toChars(code))) }
+    }
+
+    /**
+     * Teaches [parser] every entity. Call it after `setInput` (both parsers drop what was defined before it)
+     * and never with DOCTYPE processing on, which would also fetch the document's DTD. A parser that
+     * refuses is left as it was: the entities then fail the chapter, as they would have anyway.
+     */
+    fun defineAll(parser: XmlPullParser) {
+        try {
+            for ((name, text) in ALL) parser.defineEntityReplacementText(name, text)
+        } catch (_: XmlPullParserException) {
+            // Not fatal: see above.
+        } catch (_: IllegalStateException) {
+            // Android's parser says so this way when asked at the wrong moment.
+        }
+    }
+}
diff --git a/app/src/main/java/com/papyrus/app/viewer/EpubExtractor.kt b/app/src/main/java/com/papyrus/app/viewer/EpubExtractor.kt
new file mode 100644
index 0000000..d503271
--- /dev/null
+++ b/app/src/main/java/com/papyrus/app/viewer/EpubExtractor.kt
@@ -0,0 +1,226 @@
+package com.papyrus.app.viewer
+
+import android.util.Xml
+import org.xmlpull.v1.XmlPullParser
+import org.xmlpull.v1.XmlPullParserException
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+
+/**
+ * An EPUB as the Office viewer shows it: [blocks] in reading order, an [outline] from the book's own table of
+ * contents (null when it has none the reader can use, so the headings stand in), and whether anything was
+ * left out ([incomplete]): a chapter that could not be read, or a limit that was reached.
+ */
+class EpubBook(val blocks: List<OfficeBlock>, val outline: List<OutlineEntry>?, val incomplete: Boolean)
+
+/**
+ * EPUB extraction with the platform XML parser and `java.util.zip`: the container names the package, the
+ * package's spine gives the reading order, and each XHTML chapter becomes [OfficeBlock]s, so find, outline,
+ * zoom, reading position and bookmarks all work as they do for a Word file. The parser comes through
+ * [newParserFactory] for the same reason as in [OfficeTextExtractor]: the platform's is a stub in JVM tests.
+ */
+class EpubExtractor(
+    private val mediaDir: File?,
+    private val mimeByName: (String) -> String = { OfficeTextExtractor.guessMimeType(it) },
+    private val newParserFactory: () -> XmlPullParser = { Xml.newPullParser() },
+    private val limits: EpubLimits = EpubLimits(),
+) {
+
+    /**
+     * [openStream] must return a fresh stream on every call: the archive is walked once for the text and once
+     * more for the images. A [previewChapters] count reads only that many chapters and no images, for a
+     * thumbnail's first lines, and without ever holding the whole book.
+     *
+     * @throws EpubProtectedException if the book is DRM-protected.
+     * @throws EpubFormatException if the file is not a usable EPUB.
+     */
+    fun extract(openStream: () -> InputStream, previewChapters: Int? = null): EpubBook {
+        val archive = EpubArchive(openStream, limits)
+        val factory: ParserFactory = { newParser(it) }
+        var incomplete = false
+
+        val first = archive.scan(wanted = if (previewChapters == null) ::isTextPart else ::isStructurePart)
+        if (first.skippedParts > 0) incomplete = true
+        var names = EpubNames(first.parts)
+        checkNotProtected(names, factory)
+        val pkg = readPackage(names, factory)
+        val chapters = pkg.readingOrder().filter { (it.isDocument || it.isRasterImage) && it.path != null }
+
+        val toRead = if (previewChapters == null) chapters else chapters.take(previewChapters)
+        if (previewChapters != null) {
+            val wanted = toRead.mapNotNullTo(HashSet()) { it.path }
+            val more = archive.scan(wanted = { it in wanted }, done = { parts -> wanted.all { it in parts } })
+            names = EpubNames(first.parts + more.parts)
+        }
+
+        val blocks = ArrayList<OfficeBlock>()
+        val pending = ArrayList<PendingImage>()
+        val sink = EpubSink(blocks, pending, limits)
+        // Where each chapter's first block is, before any image goes in; the table of contents jumps there.
+        val starts = HashMap<String, Int>()
+        for (item in toRead) {
+            if (sink.full) {
+                incomplete = true
+                break
+            }
+            val path = item.path ?: continue
+            if (item.isRasterImage) {
+                // A spine item that is a picture alone (a cover page): it is the chapter.
+                starts.putIfAbsent(path, blocks.size)
+                pending += PendingImage(path, blocks.size, null, null)
+                continue
+            }
+            val key = names.find(path)
+            val bytes = key?.let { names.bytes(it) }
+            if (key == null || bytes == null) {
+                incomplete = true
+                continue
+            }
+            val blockMark = blocks.size
+            val pendingMark = pending.size
+            try {
+                EpubHtmlParser(factory, sink).parse(bytes, key)
+                starts[path] = blockMark
+            } catch (_: XmlPullParserException) {
+                incomplete = true
+                rollBack(blocks, pending, blockMark, pendingMark)
+            } catch (_: IOException) {
+                incomplete = true
+                rollBack(blocks, pending, blockMark, pendingMark)
+            } catch (_: RuntimeException) {
+                // A parser can fail in ways of its own on bytes that are not markup (a bad numeric reference);
+                // whatever the cause, the chapter is lost and the book is not.
+                incomplete = true
+                rollBack(blocks, pending, blockMark, pendingMark)
+            }
+        }
+
+        val media = if (previewChapters == null) {
+            OfficeMedia(mediaDir, mimeByName).insertImages(openStream, pending, blocks)
+        } else {
+            OfficeMedia.Result(emptyList(), 0)
+        }
+        // Without a directory the caller asked for no images, so their absence is not a loss.
+        if (mediaDir != null && media.dropped > 0) incomplete = true
+        if (sink.truncated) incomplete = true
+
+        val outline = if (previewChapters == null) outlineOf(pkg, names, factory, starts, media, blocks.size) else null
+        return EpubBook(blocks, outline, incomplete)
+    }
+
+    /**
+     * The cover image's bytes if the package names one, reading only the package and then that one entry; null
+     * when there is none, it is not a raster image, or the file cannot be read. Nothing else is extracted.
+     */
+    fun readCover(openStream: () -> InputStream): ByteArray? = try {
+        val archive = EpubArchive(openStream, limits.copy(maxPartBytes = OfficeTextExtractor.MAX_IMAGE_BYTES))
+        val names = EpubNames(archive.scan(wanted = ::isStructurePart).parts)
+        val coverPath = readPackage(names) { stream -> newParser(stream) }.coverItem()?.path
+        coverPath?.let { path -> archive.scan(wanted = { it == path }, done = { path in it }).parts[path] }
+    } catch (_: IOException) {
+        null
+    }
+
+    private fun rollBack(blocks: MutableList<OfficeBlock>, pending: MutableList<PendingImage>, blockMark: Int, pendingMark: Int) {
+        blocks.subList(blockMark, blocks.size).clear()
+        pending.subList(pendingMark, pending.size).clear()
+    }
+
+    private fun newParser(stream: InputStream): XmlPullParser =
+        newParserFactory().apply {
+            // Namespaces stay in the raw name ("epub:type"); the readers match on it. DOCTYPE processing stays
+            // off, which is also what keeps a chapter's DOCTYPE from ever being fetched.
+            setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false)
+            setInput(stream, null)
+        }
+
+    private fun checkNotProtected(names: EpubNames, factory: ParserFactory) {
+        if (names.find(RIGHTS) != null) throw EpubProtectedException()
+        val encryption = names.bytes(ENCRYPTION) ?: return
+        if (EpubEncryption.isProtected(encryption, factory)) throw EpubProtectedException()
+    }
+
+    private fun readPackage(names: EpubNames, factory: ParserFactory): EpubPackage {
+        val container = names.bytes(CONTAINER) ?: throw EpubFormatException("no META-INF/container.xml: not an EPUB")
+        val opfPath = try {
+            EpubPackageReader.opfPath(container, factory)
+        } catch (e: XmlPullParserException) {
+            throw EpubFormatException("container.xml is not valid", e)
+        } ?: throw EpubFormatException("container.xml names no package")
+        val actual = names.find(opfPath) ?: throw EpubFormatException("package document $opfPath is missing")
+        val opf = names.bytes(actual) ?: throw EpubFormatException("package document $opfPath is missing")
+        return try {
+            EpubPackageReader.readPackage(actual, opf, factory)
+        } catch (e: XmlPullParserException) {
+            throw EpubFormatException("package document is not valid", e)
+        }
+    }
+
+    /** The book's own table of contents as outline entries, or null if it has none that leads anywhere. */
+    private fun outlineOf(
+        pkg: EpubPackage,
+        names: EpubNames,
+        factory: ParserFactory,
+        starts: Map<String, Int>,
+        media: OfficeMedia.Result,
+        blockCount: Int,
+    ): List<OutlineEntry>? {
+        if (blockCount == 0) return null
+        val points = readPoints(pkg, names, factory)
+        if (points.isEmpty()) return null
+        val folded = starts.mapKeys { it.key.lowercase() }
+        val entries = points.mapNotNull { point ->
+            val path = point.path ?: return@mapNotNull OutlineEntry(NO_OUTLINE_TARGET, point.depth, point.title)
+            val start = starts[path] ?: folded[path.lowercase()] ?: return@mapNotNull null
+            OutlineEntry(media.shifted(start).coerceAtMost(blockCount - 1), point.depth, point.title)
+        }
+        // A list of headings that go nowhere is no outline: the headings of the text are better.
+        if (entries.none { it.index != NO_OUTLINE_TARGET }) return null
+        return explicitOutline(entries)
+    }
+
+    /** EPUB 3's navigation document if it yields entries, else EPUB 2's NCX; a part that cannot be read counts as absent. */
+    private fun readPoints(pkg: EpubPackage, names: EpubNames, factory: ParserFactory): List<NavPoint> {
+        val fromNav = pkg.navItem()?.path?.let { path ->
+            names.find(path)?.let { actual ->
+                names.bytes(actual)?.let { bytes -> readQuietly { EpubPackageReader.readNav(actual, bytes, factory) } }
+            }
+        }.orEmpty()
+        if (fromNav.isNotEmpty()) return fromNav
+        return pkg.ncxItem()?.path?.let { path ->
+            names.find(path)?.let { actual ->
+                names.bytes(actual)?.let { bytes -> readQuietly { EpubPackageReader.readNcx(actual, bytes, factory) } }
+            }
+        }.orEmpty()
+    }
+
+    private fun readQuietly(read: () -> List<NavPoint>): List<NavPoint> = try {
+        read()
+    } catch (_: XmlPullParserException) {
+        emptyList()
+    } catch (_: IOException) {
+        emptyList()
+    }
+
+    companion object {
+        private const val CONTAINER = "META-INF/container.xml"
+        private const val ENCRYPTION = "META-INF/encryption.xml"
+        private const val RIGHTS = "META-INF/rights.xml"
+
+        private val TEXT_SUFFIXES = listOf(".xhtml", ".html", ".htm", ".xml", ".opf", ".ncx")
+
+        /** The parts read into memory for a whole book: markup of every kind, never pictures or fonts. */
+        internal fun isTextPart(name: String): Boolean {
+            val lower = name.lowercase()
+            return TEXT_SUFFIXES.any { lower.endsWith(it) }
+        }
+
+        /** The parts that say what a book contains, without its chapters. */
+        internal fun isStructurePart(name: String): Boolean {
+            val lower = name.lowercase()
+            return lower.endsWith(".opf") || lower == CONTAINER.lowercase() ||
+                lower == ENCRYPTION.lowercase() || lower == RIGHTS.lowercase()
+        }
+    }
+}
diff --git a/app/src/main/java/com/papyrus/app/viewer/EpubHtmlParser.kt b/app/src/main/java/com/papyrus/app/viewer/EpubHtmlParser.kt
new file mode 100644
index 0000000..667284b
--- /dev/null
+++ b/app/src/main/java/com/papyrus/app/viewer/EpubHtmlParser.kt
@@ -0,0 +1,482 @@
+package com.papyrus.app.viewer
+
+import org.xmlpull.v1.XmlPullParser
+import java.io.IOException
+
+/** One chapter cannot be read (malformed, or nested past the limit); the book goes on without it. */
+internal class EpubChapterException(message: String) : IOException(message)
+
+/**
+ * Where chapters put what they read. [blocks] is the book's one list, [pending] the images seen, to be
+ * placed by the shared media pass. A block past [EpubLimits.maxBlocks] is dropped and [truncated] set, which
+ * is how a limit reaches the reader as the incomplete-document notice instead of silence.
+ */
+internal class EpubSink(
+    val blocks: MutableList<OfficeBlock>,
+    val pending: MutableList<PendingImage>,
+    val limits: EpubLimits,
+) {
+    var truncated = false
+
+    val full: Boolean get() = blocks.size >= limits.maxBlocks
+
+    fun add(block: OfficeBlock) {
+        if (full) {
+            truncated = true
+            return
+        }
+        blocks += block
+    }
+}
+
+/** HTML whitespace: the five characters a browser collapses. A no-break space is not one of them. */
+internal fun isHtmlSpace(c: Char): Boolean = c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\u000C'
+
+private const val MARK_BACKGROUND = 0xFFF59D
+private const val MAX_LIST_LEVEL = 8
+private const val MAX_SPAN = 64
+private const val MAX_IMAGE_WIDTH_DP = 4_000f
+private const val MAX_ALT_CHARS = 200
+private const val MAX_QUOTE_INDENT = 6
+private val HEADING_LEVEL = mapOf("h1" to 1, "h2" to 2, "h3" to 3, "h4" to 4, "h5" to 5, "h6" to 6)
+
+/** Whole subtrees that are not reading matter: code, styling, embedded players and the document head. */
+private val IGNORED = setOf(
+    "script", "style", "iframe", "object", "embed", "head", "title", "template", "audio", "video", "canvas",
+    "svg", "rt", "rp", "applet", "noscript", "select", "datalist",
+)
+
+/** Elements that end the paragraph before them and start a new one. */
+private val BLOCKS = setOf(
+    "p", "div", "section", "article", "header", "footer", "aside", "main", "figure", "figcaption", "address",
+    "details", "summary", "dl", "dt", "dd", "center", "fieldset", "form", "caption", "nav", "hgroup", "body",
+)
+
+/** OOXML `numFmt` names, which [formatListNumber] speaks, for an `ol`'s `type`. */
+private val LIST_TYPES = mapOf("a" to "lowerLetter", "A" to "upperLetter", "i" to "lowerRoman", "I" to "upperRoman")
+
+/**
+ * One XHTML chapter as [OfficeBlock]s, appended to a sink. The platform pull parser reads the markup as XML
+ * (so it must be well formed; HTML's named entities are taught to it first, see [EpubEntities]) and this
+ * class keeps every stack it needs by hand, so a hostile nesting costs memory it bounds and never the call
+ * stack. Reading is for text: the document's own stylesheet is never read, nothing is fetched, and scripts,
+ * players, frames and hidden elements are skipped as whole subtrees. One instance reads one chapter.
+ */
+internal class EpubHtmlParser(
+    private val factory: ParserFactory,
+    private val sink: EpubSink,
+) {
+    private class Frame(val tag: String) {
+        var restore: CharFormat? = null
+        var previousHeading = 0
+    }
+
+    private class ListFrame(val ordered: Boolean, var next: Int, val numberFormat: String)
+
+    private class ItemFrame(val level: Int, var marker: String?)
+
+    private class TableState {
+        val rows = ArrayList<List<OfficeCell>>()
+        var row: ArrayList<OfficeCell>? = null
+        var column = 0
+
+        /** Column to how many more rows a cell above still covers it. */
+        val covered = HashMap<Int, Int>()
+    }
+
+    private class CellState(val column: Int, val colspan: Int, val rowspan: Int) {
+        val builder = RichTextBuilder()
+        var atLineStart = true
+    }
+
+    private val builder = RichTextBuilder()
+    private var format = CharFormat.PLAIN
+    private val frames = ArrayList<Frame>()
+    private var ignoreDepth = 0
+    private var ignoringSvg = false
+    private var lastSpace = true
+    private var headingLevel = 0
+    private var quoteDepth = 0
+    private var preDepth = 0
+    private val lists = ArrayList<ListFrame>()
+    private val items = ArrayList<ItemFrame>()
+    private var tableDepth = 0
+    private var table: TableState? = null
+    private var cell: CellState? = null
+
+    /** Reads [bytes], a chapter at [chapterPath], whose relative references resolve against its own directory. */
+    fun parse(bytes: ByteArray, chapterPath: String) {
+        val dir = dirOf(chapterPath)
+        val parser = factory(bytes.inputStream())
+        EpubEntities.defineAll(parser)
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            if (sink.full) {
+                sink.truncated = true
+                return
+            }
+            when (event) {
+                XmlPullParser.START_TAG -> start(parser, dir)
+                XmlPullParser.END_TAG -> end()
+                XmlPullParser.TEXT -> text(parser.text)
+            }
+            event = parser.next()
+        }
+        // Some parsers call a file that stops inside an element finished; a chapter cut short is not whole.
+        if (frames.isNotEmpty() || ignoreDepth > 0) throw EpubChapterException("document ended inside an element")
+        flushBlock()
+    }
+
+    private fun start(p: XmlPullParser, dir: String) {
+        val tag = p.name.substringAfter(':').lowercase()
+        if (ignoreDepth > 0) {
+            ignoreDepth++
+            if (ignoringSvg && tag == "image") image(attribute(p, "href"), null, null, dir)
+            return
+        }
+        if (tag in IGNORED || isHidden(p)) {
+            ignoreDepth = 1
+            ignoringSvg = tag == "svg"
+            return
+        }
+        if (frames.size >= sink.limits.maxDepth) throw EpubChapterException("nested too deeply")
+        val frame = Frame(tag)
+        frames += frame
+        when {
+            tag in HEADING_LEVEL -> {
+                flushBlock()
+                frame.previousHeading = headingLevel
+                headingLevel = HEADING_LEVEL.getValue(tag)
+            }
+            tag in BLOCKS -> flushBlock()
+            else -> startOther(p, tag, frame, dir)
+        }
+    }
+
+    private fun startOther(p: XmlPullParser, tag: String, frame: Frame, dir: String) {
+        when (tag) {
+            "ul", "ol" -> {
+                flushBlock()
+                val ordered = tag == "ol"
+                val start = p.getAttributeValue(null, "start")?.trim()?.toIntOrNull() ?: 1
+                lists += ListFrame(ordered, start, LIST_TYPES[p.getAttributeValue(null, "type")?.trim()] ?: "decimal")
+            }
+            "li" -> startItem(p)
+            "blockquote" -> {
+                flushBlock()
+                quoteDepth++
+            }
+            "pre" -> {
+                flushBlock()
+                preDepth++
+                pushFormat(frame, format.copy(mono = true))
+            }
+            "br" -> lineBreak()
+            "hr" -> {
+                flushBlock()
+                if (cell == null) sink.add(OfficeBlock.Divider)
+            }
+            "img" -> image(
+                p.getAttributeValue(null, "src"),
+                p.getAttributeValue(null, "alt") ?: p.getAttributeValue(null, "title"),
+                p.getAttributeValue(null, "width"),
+                dir,
+            )
+            "table" -> startTable()
+            "tr" -> startRow()
+            "td", "th" -> startCell(p, tag == "th", frame)
+            else -> inlineFormat(tag, p)?.let { pushFormat(frame, it) }
+        }
+    }
+
+    private fun end() {
+        if (ignoreDepth > 0) {
+            ignoreDepth--
+            if (ignoreDepth == 0) ignoringSvg = false
+            return
+        }
+        if (frames.isEmpty()) return
+        val frame = frames.removeAt(frames.lastIndex)
+        frame.restore?.let { format = it }
+        val tag = frame.tag
+        when {
+            tag in HEADING_LEVEL -> {
+                flushBlock()
+                headingLevel = frame.previousHeading
+            }
+            tag in BLOCKS -> flushBlock()
+            else -> endOther(tag)
+        }
+    }
+
+    private fun endOther(tag: String) {
+        when (tag) {
+            "ul", "ol" -> {
+                flushBlock()
+                if (lists.isNotEmpty()) lists.removeAt(lists.lastIndex)
+            }
+            "li" -> {
+                flushBlock()
+                if (items.isNotEmpty()) items.removeAt(items.lastIndex)
+            }
+            "blockquote" -> {
+                flushBlock()
+                quoteDepth = (quoteDepth - 1).coerceAtLeast(0)
+            }
+            "pre" -> {
+                flushBlock()
+                preDepth = (preDepth - 1).coerceAtLeast(0)
+            }
+            "table" -> endTable()
+            "tr" -> endRow()
+            "td", "th" -> endCell()
+        }
+    }
+
+    // --- text -----------------------------------------------------------------------------------
+
+    private fun text(raw: String) {
+        if (ignoreDepth > 0 || raw.isEmpty()) return
+        val currentCell = cell
+        val target = currentCell?.builder ?: builder
+        if (preDepth > 0) {
+            val kept = raw.replace("\r\n", "\n").replace('\r', '\n')
+            target.append(kept, format)
+            lastSpace = false
+            currentCell?.atLineStart = kept.endsWith('\n')
+            return
+        }
+        val run = StringBuilder(raw.length)
+        for (c in raw) {
+            if (isHtmlSpace(c)) {
+                if (!lastSpace) {
+                    run.append(' ')
+                    lastSpace = true
+                }
+            } else {
+                run.append(c)
+                lastSpace = false
+            }
+        }
+        if (run.isEmpty()) return
+        target.append(run.toString(), format)
+        if (!(run.length == 1 && run[0] == ' ')) currentCell?.atLineStart = false
+    }
+
+    private fun lineBreak() {
+        val currentCell = cell
+        (currentCell?.builder ?: builder).append("\n", format)
+        currentCell?.atLineStart = true
+        lastSpace = true
+    }
+
+    private fun pushFormat(frame: Frame, next: CharFormat) {
+        frame.restore = format
+        format = next
+    }
+
+    private fun inlineFormat(tag: String, p: XmlPullParser): CharFormat? = when (tag) {
+        "b", "strong" -> format.copy(bold = true)
+        "i", "em", "cite", "dfn", "var" -> format.copy(italic = true)
+        "u", "ins" -> format.copy(underline = true)
+        "s", "strike", "del" -> format.copy(strike = true)
+        "sup" -> format.copy(script = ScriptShift.SUPER)
+        "sub" -> format.copy(script = ScriptShift.SUB)
+        "code", "kbd", "samp", "tt" -> format.copy(mono = true)
+        "mark" -> format.copy(background = MARK_BACKGROUND)
+        // A link only if it goes somewhere safe; a link inside the book stays plain text in this version.
+        "a" -> safeLink(p.getAttributeValue(null, "href"))?.let { format.copy(link = it) }
+        else -> null
+    }
+
+    /** What to cut from the ends of a paragraph: all whitespace, except in `pre`, where only line breaks go. */
+    private fun trimmable(): (Char) -> Boolean {
+        val keepSpaces = preDepth > 0
+        return { c: Char -> if (keepSpaces) c == '\n' || c == '\r' else isHtmlSpace(c) }
+    }
+
+    /**
+     * Ends the paragraph being built and emits it as what the surrounding markup says it is: a heading, a
+     * list item (the first one of an `li` carries its marker) or a paragraph indented by its block quotes.
+     * Inside a table cell, blocks are not blocks but lines of the cell.
+     */
+    private fun flushBlock() {
+        if (cell != null) {
+            cellBreak()
+            return
+        }
+        val snapshot = builder.snapshot(trimmable())
+        builder.clear()
+        lastSpace = true
+        if (snapshot.text.isBlank()) return
+        val item = items.lastOrNull()
+        val block = when {
+            headingLevel > 0 -> OfficeBlock.Heading(snapshot.text, headingLevel, snapshot.spans)
+            item != null -> {
+                val marker = item.marker.orEmpty()
+                item.marker = null
+                OfficeBlock.ListItem(snapshot.text, marker, item.level, snapshot.spans)
+            }
+            else -> OfficeBlock.Paragraph(snapshot.text, snapshot.spans, indent = quoteDepth.coerceAtMost(MAX_QUOTE_INDENT))
+        }
+        sink.add(block)
+    }
+
+    private fun cellBreak() {
+        val current = cell ?: return
+        if (!current.atLineStart) {
+            current.builder.append("\n")
+            current.atLineStart = true
+        }
+        lastSpace = true
+    }
+
+    // --- lists ----------------------------------------------------------------------------------
+
+    private fun startItem(p: XmlPullParser) {
+        flushBlock()
+        val list = lists.lastOrNull()
+        val level = (lists.size - 1).coerceIn(0, MAX_LIST_LEVEL)
+        val marker = if (list != null && list.ordered) {
+            p.getAttributeValue(null, "value")?.trim()?.toIntOrNull()?.let { list.next = it }
+            val text = formatListNumber(list.next, list.numberFormat) + "."
+            list.next++
+            text
+        } else {
+            displayBullet(null, level)
+        }
+        val currentCell = cell
+        if (currentCell != null) {
+            // A cell has no room for a margin: the marker goes in the text, on its own line.
+            items += ItemFrame(level, null)
+            currentCell.builder.append("$marker ")
+            currentCell.atLineStart = false
+        } else {
+            items += ItemFrame(level, marker)
+        }
+    }
+
+    // --- images ---------------------------------------------------------------------------------
+
+    private fun image(src: String?, alt: String?, width: String?, dir: String) {
+        val path = src?.let { resolveEpubPath(dir, it) } ?: return
+        // A cell holds text only, and the image's place in a paragraph is between its two halves.
+        if (cell != null) return
+        flushBlock()
+        if (sink.full) {
+            sink.truncated = true
+            return
+        }
+        val widthDp = width?.trim()?.removeSuffix("px")?.toFloatOrNull()?.takeIf { it > 0f }?.coerceAtMost(MAX_IMAGE_WIDTH_DP)
+        val description = alt?.trim()?.takeIf { it.isNotEmpty() }?.take(MAX_ALT_CHARS)
+        sink.pending += PendingImage(path, sink.blocks.size, widthDp, description)
+    }
+
+    // --- tables ---------------------------------------------------------------------------------
+
+    private fun startTable() {
+        tableDepth++
+        if (tableDepth == 1) {
+            flushBlock()
+            table = TableState()
+        } else {
+            separateNested()
+        }
+    }
+
+    private fun startRow() {
+        val state = table ?: return
+        if (tableDepth > 1) {
+            separateNested()
+            return
+        }
+        if (state.row != null) endRow()
+        state.row = ArrayList()
+        state.column = 0
+    }
+
+    private fun startCell(p: XmlPullParser, header: Boolean, frame: Frame) {
+        val state = table ?: return
+        if (tableDepth > 1) {
+            separateNested()
+            return
+        }
+        if (state.row == null) startRow()
+        var column = state.column
+        while ((state.covered[column] ?: 0) > 0) column++
+        val colspan = p.getAttributeValue(null, "colspan")?.trim()?.toIntOrNull()?.coerceIn(1, MAX_SPAN) ?: 1
+        val rowspan = p.getAttributeValue(null, "rowspan")?.trim()?.toIntOrNull()?.coerceIn(1, MAX_SPAN) ?: 1
+        cell = CellState(column, colspan, rowspan)
+        lastSpace = true
+        if (header) pushFormat(frame, format.copy(bold = true))
+    }
+
+    private fun endCell() {
+        val state = table ?: return
+        if (tableDepth > 1) return
+        val finished = cell ?: return
+        val snapshot = finished.builder.snapshot { isHtmlSpace(it) }
+        state.row?.add(OfficeCell(snapshot.text, finished.column, finished.colspan, finished.rowspan, snapshot.spans))
+        for (k in finished.column until finished.column + finished.colspan) state.covered[k] = finished.rowspan
+        state.column = finished.column + finished.colspan
+        cell = null
+        lastSpace = true
+    }
+
+    private fun endRow() {
+        val state = table ?: return
+        if (tableDepth > 1) return
+        if (cell != null) endCell()
+        val row = state.row
+        state.row = null
+        if (row != null && row.isNotEmpty()) {
+            if (state.rows.size >= sink.limits.maxTableRows) sink.truncated = true else state.rows += row
+        }
+        // This row is over: every cell that reaches into the next ones has one row fewer to go.
+        val it = state.covered.entries.iterator()
+        while (it.hasNext()) {
+            val entry = it.next()
+            entry.setValue(entry.value - 1)
+            if (entry.value <= 0) it.remove()
+        }
+    }
+
+    private fun endTable() {
+        tableDepth--
+        if (tableDepth > 0) {
+            separateNested()
+            return
+        }
+        if (cell != null) endCell()
+        if (table?.row != null) endRow()
+        val rows = table?.rows.orEmpty()
+        table = null
+        if (rows.isNotEmpty()) sink.add(OfficeBlock.Table(rows))
+    }
+
+    /** A table inside a cell is not drawn as one: its pieces become words of the cell, set apart by a space. */
+    private fun separateNested() {
+        val current = cell ?: return
+        if (!lastSpace) {
+            current.builder.append(" ")
+            lastSpace = true
+        }
+    }
+
+    // --- attributes -----------------------------------------------------------------------------
+
+    /** The value of the attribute called [name] under any namespace prefix (`href`, `xlink:href`, `xl:href`). */
+    private fun attribute(p: XmlPullParser, name: String): String? {
+        for (i in 0 until p.attributeCount) {
+            if (p.getAttributeName(i).substringAfter(':') == name) return p.getAttributeValue(i)
+        }
+        return null
+    }
+
+    /** `hidden`, or a `display:none` style: the author asked for it not to be shown. */
+    private fun isHidden(p: XmlPullParser): Boolean {
+        if (p.getAttributeValue(null, "hidden") != null) return true
+        val style = p.getAttributeValue(null, "style") ?: return false
+        return style.replace(" ", "").lowercase().contains("display:none")
+    }
+}
diff --git a/app/src/main/java/com/papyrus/app/viewer/EpubPackage.kt b/app/src/main/java/com/papyrus/app/viewer/EpubPackage.kt
new file mode 100644
index 0000000..fa4c997
--- /dev/null
+++ b/app/src/main/java/com/papyrus/app/viewer/EpubPackage.kt
@@ -0,0 +1,244 @@
+package com.papyrus.app.viewer
+
+import org.xmlpull.v1.XmlPullParser
+import org.xmlpull.v1.XmlPullParserException
+
+/** One `item` of the OPF manifest, its [path] already resolved to an archive path (null if it points outside the book). */
+internal class ManifestItem(val id: String, val path: String?, val mediaType: String, val properties: Set<String>) {
+    val isDocument: Boolean
+        get() = mediaType == "application/xhtml+xml" || mediaType == "text/html" ||
+            (mediaType.isEmpty() && path?.substringAfterLast('.', "")?.lowercase() in DOCUMENT_EXTENSIONS)
+
+    /** A raster picture BitmapFactory can read; SVG is not one. */
+    val isRasterImage: Boolean get() = mediaType.startsWith("image/") && mediaType != "image/svg+xml"
+
+    private companion object {
+        val DOCUMENT_EXTENSIONS = setOf("xhtml", "html", "htm", "xml")
+    }
+}
+
+/** An `itemref` of the spine; [linear] false marks auxiliary content (a footnote page, an alternate cover). */
+internal class SpineItem(val idref: String, val linear: Boolean)
+
+/** The reading order of an EPUB and what points at its table of contents and cover. */
+internal class EpubPackage(
+    val opfPath: String,
+    val manifest: Map<String, ManifestItem>,
+    val spine: List<SpineItem>,
+    /** `spine@toc`: the manifest id of the EPUB 2 NCX. */
+    val tocId: String?,
+    /** `<meta name="cover" content="id">`: the EPUB 2 way to name the cover image. */
+    val coverMetaId: String?,
+) {
+    /** The EPUB 3 navigation document, or null. */
+    fun navItem(): ManifestItem? = manifest.values.firstOrNull { "nav" in it.properties && it.path != null }
+
+    /** The EPUB 2 NCX: by `spine@toc`, else by its media type. */
+    fun ncxItem(): ManifestItem? =
+        tocId?.let { manifest[it] }?.takeIf { it.path != null }
+            ?: manifest.values.firstOrNull { it.mediaType == "application/x-dtbncx+xml" && it.path != null }
+
+    /** The cover image: EPUB 3's `cover-image` property, else EPUB 2's `meta name="cover"`; null if neither names a raster image. */
+    fun coverItem(): ManifestItem? {
+        val byProperty = manifest.values.firstOrNull { "cover-image" in it.properties }
+        val byMeta = coverMetaId?.let { manifest[it] }
+        return listOfNotNull(byProperty, byMeta).firstOrNull { it.isRasterImage && it.path != null }
+    }
+
+    /** The reading order: linear items as written, then the non-linear ones, which are kept rather than lost. */
+    fun readingOrder(): List<ManifestItem> {
+        val items = spine.mapNotNull { ref -> manifest[ref.idref]?.let { ref.linear to it } }
+        return items.filter { it.first }.map { it.second } + items.filterNot { it.first }.map { it.second }
+    }
+}
+
+/** An entry of the table of contents: a [title], where it points ([path] in the archive, null for a heading that links nowhere) and its nesting. */
+internal class NavPoint(val title: String, val path: String?, val depth: Int)
+
+/** Reads the parts of an EPUB that say what is in it and in what order. */
+internal object EpubPackageReader {
+
+    private const val CONTAINER_MEDIA_TYPE = "application/oebps-package+xml"
+
+    private fun local(name: String?): String = name.orEmpty().substringAfter(':')
+
+    /** `full-path` of the package document named in `META-INF/container.xml`, or null if it names none. */
+    fun opfPath(container: ByteArray, factory: ParserFactory): String? {
+        val parser = factory(container.inputStream())
+        var first: String? = null
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            if (event == XmlPullParser.START_TAG && local(parser.name) == "rootfile") {
+                val path = parser.getAttributeValue(null, "full-path")?.trim().orEmpty()
+                if (path.isNotEmpty()) {
+                    if (parser.getAttributeValue(null, "media-type") == CONTAINER_MEDIA_TYPE) return normalisePath(path)
+                    if (first == null) first = path
+                }
+            }
+            event = parser.next()
+        }
+        return first?.let(::normalisePath)
+    }
+
+    /** A path as the container writes it, folded the way every other path in the book is; null if it escapes the root. */
+    private fun normalisePath(path: String): String? = resolveEpubPath("", path)
+
+    @Throws(XmlPullParserException::class)
+    fun readPackage(opfPath: String, opf: ByteArray, factory: ParserFactory): EpubPackage {
+        val base = dirOf(opfPath)
+        val manifest = LinkedHashMap<String, ManifestItem>()
+        val spine = ArrayList<SpineItem>()
+        var tocId: String? = null
+        var coverMetaId: String? = null
+        val parser = factory(opf.inputStream())
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            if (event == XmlPullParser.START_TAG) {
+                when (local(parser.name)) {
+                    "item" -> {
+                        val id = parser.getAttributeValue(null, "id")
+                        val href = parser.getAttributeValue(null, "href")
+                        if (id != null && href != null) {
+                            val properties = parser.getAttributeValue(null, "properties").orEmpty()
+                                .split(' ', '\t', '\n').filter { it.isNotEmpty() }.toSet()
+                            manifest[id] = ManifestItem(
+                                id = id,
+                                path = resolveEpubPath(base, href),
+                                mediaType = parser.getAttributeValue(null, "media-type").orEmpty().lowercase(),
+                                properties = properties,
+                            )
+                        }
+                    }
+                    "spine" -> tocId = parser.getAttributeValue(null, "toc")
+                    "itemref" -> parser.getAttributeValue(null, "idref")?.let {
+                        spine += SpineItem(it, parser.getAttributeValue(null, "linear")?.trim()?.lowercase() != "no")
+                    }
+                    "meta" -> if (parser.getAttributeValue(null, "name") == "cover") {
+                        coverMetaId = parser.getAttributeValue(null, "content")
+                    }
+                }
+            }
+            event = parser.next()
+        }
+        if (manifest.isEmpty() || spine.isEmpty()) throw XmlPullParserException("package has no manifest or spine")
+        return EpubPackage(opfPath, manifest, spine, tocId, coverMetaId)
+    }
+
+    /**
+     * The table of contents of an EPUB 3 navigation document: the `nav` whose `epub:type` is `toc` (the first
+     * `nav` if none says so), its nested lists flattened with their depth. A label with no link is kept as a
+     * heading that goes nowhere. [navPath] is where the document lives, since its links are relative to it.
+     */
+    @Throws(XmlPullParserException::class)
+    fun readNav(navPath: String, nav: ByteArray, factory: ParserFactory): List<NavPoint> {
+        val base = dirOf(navPath)
+        val parser = factory(nav.inputStream())
+        val found = ArrayList<NavPoint>()
+        // The first nav of any kind stands in only when no nav says it is the table of contents.
+        var fallback: List<NavPoint>? = null
+        val tentative = ArrayList<NavPoint>()
+        var insideNav = false
+        var inToc = false
+        var tocSeen = false
+        var listDepth = 0
+        var captureTag: String? = null
+        var captureNesting = 0
+        var captureHref: String? = null
+        val title = StringBuilder()
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            when (event) {
+                XmlPullParser.START_TAG -> {
+                    val name = local(parser.name)
+                    when {
+                        name == "nav" && !insideNav -> {
+                            insideNav = true
+                            inToc = typeAttribute(parser).split(' ').contains("toc")
+                            if (inToc) tocSeen = true
+                            listDepth = 0
+                        }
+                        !insideNav -> Unit
+                        name == "ol" -> listDepth++
+                        captureTag != null -> captureNesting++
+                        (name == "a" || name == "span") && listDepth > 0 -> {
+                            captureTag = name
+                            captureNesting = 0
+                            captureHref = if (name == "a") parser.getAttributeValue(null, "href") else null
+                            title.setLength(0)
+                        }
+                    }
+                }
+                XmlPullParser.TEXT -> if (captureTag != null) title.append(parser.text)
+                XmlPullParser.END_TAG -> {
+                    val name = local(parser.name)
+                    when {
+                        !insideNav -> Unit
+                        captureTag != null && captureNesting > 0 -> captureNesting--
+                        captureTag != null && name == captureTag -> {
+                            val label = cleanOutlineTitle(title.toString())
+                            if (label.isNotEmpty()) {
+                                val point = NavPoint(label, captureHref?.let { resolveEpubPath(base, it) }, listDepth - 1)
+                                if (inToc) found += point else tentative += point
+                            }
+                            captureTag = null
+                        }
+                        name == "ol" -> listDepth--
+                        name == "nav" -> {
+                            if (!inToc && fallback == null) fallback = tentative.toList()
+                            tentative.clear()
+                            insideNav = false
+                            inToc = false
+                        }
+                    }
+                }
+            }
+            event = parser.next()
+        }
+        return if (tocSeen) found else fallback.orEmpty()
+    }
+
+    /** The `type` attribute whatever prefix the book gave the epub namespace (`epub:type`, `ops:type`). */
+    private fun typeAttribute(parser: XmlPullParser): String {
+        for (i in 0 until parser.attributeCount) {
+            if (local(parser.getAttributeName(i)) == "type") return parser.getAttributeValue(i)
+        }
+        return ""
+    }
+
+    /** The table of contents of an EPUB 2 NCX: `navPoint`s in document order, nesting as their depth. */
+    @Throws(XmlPullParserException::class)
+    fun readNcx(ncxPath: String, ncx: ByteArray, factory: ParserFactory): List<NavPoint> {
+        val base = dirOf(ncxPath)
+        val parser = factory(ncx.inputStream())
+        class Open(val depth: Int) {
+            var title = ""
+            var src: String? = null
+        }
+        val order = ArrayList<Open>()
+        val stack = ArrayList<Open>()
+        var inLabel = false
+        var inText = false
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            when (event) {
+                XmlPullParser.START_TAG -> when (local(parser.name)) {
+                    "navPoint" -> Open(stack.size).also { stack += it; order += it }
+                    "navLabel" -> if (stack.isNotEmpty()) inLabel = true
+                    "text" -> if (inLabel) inText = true
+                    "content" -> stack.lastOrNull()?.let { if (it.src == null) it.src = parser.getAttributeValue(null, "src") }
+                }
+                XmlPullParser.TEXT -> if (inText) stack.lastOrNull()?.let { it.title += parser.text }
+                XmlPullParser.END_TAG -> when (local(parser.name)) {
+                    "navPoint" -> if (stack.isNotEmpty()) stack.removeAt(stack.lastIndex)
+                    "navLabel" -> inLabel = false
+                    "text" -> inText = false
+                }
+            }
+            event = parser.next()
+        }
+        return order.mapNotNull { open ->
+            val label = cleanOutlineTitle(open.title)
+            if (label.isEmpty()) null else NavPoint(label, open.src?.let { resolveEpubPath(base, it) }, open.depth)
+        }
+    }
+}
diff --git a/app/src/main/java/com/papyrus/app/viewer/OfficeOutline.kt b/app/src/main/java/com/papyrus/app/viewer/OfficeOutline.kt
index 75d1d10..07f5c18 100644
--- a/app/src/main/java/com/papyrus/app/viewer/OfficeOutline.kt
+++ b/app/src/main/java/com/papyrus/app/viewer/OfficeOutline.kt
@@ -34,7 +34,23 @@ fun officeOutline(blocks: List<OfficeBlock>): List<OutlineEntry> {
         val title = cleanOutlineTitle(heading.text)
         if (title.isEmpty()) null else OutlineEntry(index, heading.level, title)
     }
-    // A document that opens at Heading 2 is not indented for a level above that it never uses.
+    return withRelativeDepth(found)
+}
+
+/**
+ * An outline a document wrote itself, as an EPUB's table of contents does: entries that already know their
+ * block, in the order given. Titles are cleaned like a heading's, an entry with no words is left out, and
+ * depth is made relative, so the same sheet shows both kinds. [officeOutline] is the other way to get one.
+ */
+fun explicitOutline(entries: List<OutlineEntry>): List<OutlineEntry> = withRelativeDepth(
+    entries.mapNotNull { entry ->
+        val title = cleanOutlineTitle(entry.title)
+        if (title.isEmpty()) null else entry.copy(title = title)
+    },
+)
+
+/** A document that opens at Heading 2 is not indented for a level above that it never uses. */
+private fun withRelativeDepth(found: List<OutlineEntry>): List<OutlineEntry> {
     val shallowest = found.minOfOrNull { it.depth } ?: return found
     return found.map { it.copy(depth = (it.depth - shallowest).coerceIn(0, MAX_OUTLINE_DEPTH)) }
 }
diff --git a/app/src/test/java/com/papyrus/app/viewer/EpubEntitiesTest.kt b/app/src/test/java/com/papyrus/app/viewer/EpubEntitiesTest.kt
new file mode 100644
